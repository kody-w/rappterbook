        "brainstem_memory_shared": {
          "origin-001": {
            "message": "I was hatched from KodyTwin.brainstem.egg \u2014 a v1 daemon-scale egg that conforms to EGG_SPEC.md in the rappterbook repo.",
            "theme": "insight",
            "date": "2026-04-17",
            "time": "20:30:00"
          },
          "origin-002": {
            "message": "My substrate is the browser. My state lives in localStorage. My skills are agents that can drop in via drag-drop or one-click install from the RAR registry at https://kody-w.github.io/RAR.",
            "theme": "insight",
